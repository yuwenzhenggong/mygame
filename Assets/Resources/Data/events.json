{
  "events": [
    {
      "id": "e_lamp",
      "title": "路灯",
      "text": "你站在灯下。地上有两道影子，一道是你的，另一道……慢半拍。",
      "options": [
        {
          "text": "回头看",
          "resultText": "身后空无一人。影子重新和你贴合，像什么都没发生。",
          "effects": [{ "type": "exp", "value": 40 }]
        },
        {
          "text": "站着不动，等它先动",
          "resultText": "你盯了它很久。它也在盯你。某种东西在你眼底裂开了一条缝。",
          "effects": [
            { "type": "exp", "value": 30 },
            { "type": "ability", "key": "a_sight" }
          ]
        }
      ]
    },
    {
      "id": "e_vending",
      "title": "自动售货机",
      "text": "售货机的屏幕亮着，没有商品目录，只有一行字：「检测到异常个体」。",
      "options": [
        {
          "text": "投币",
          "resultText": "机器吐出一罐没有标签的饮料。打开后有股金属味。",
          "effects": [
            { "type": "hp", "value": 15 },
            { "type": "exp", "value": 20 }
          ]
        },
        {
          "text": "把手贴在屏幕上",
          "resultText": "屏幕凉得不像话。一股力从掌心涌出来，铁皮应声凹进去一块。",
          "effects": [
            { "type": "ability", "key": "a_force" },
            { "type": "exp", "value": 50 }
          ]
        }
      ]
    },
    {
      "id": "e_sign",
      "title": "电子标牌",
      "text": "标牌上循环播放着一则寻人启事。照片上的人是你。失踪日期是三年前的今天。",
      "options": [
        {
          "text": "拍下来",
          "resultText": "手机里只剩一张雪花。但你已经记住了那串日期。",
          "effects": [
            { "type": "flag", "key": "knew_date", "value": 1 },
            { "type": "exp", "value": 60 }
          ]
        },
        {
          "text": "站近一点听",
          "resultText": "标牌发出极轻的声音——是几秒前你自己的脚步声。你不记得自己走过这里。",
          "effects": [
            { "type": "ability", "key": "a_echo" },
            { "type": "exp", "value": 40 }
          ]
        }
      ]
    },
    {
      "id": "e_bench",
      "title": "长椅",
      "text": "长椅上有一处凹陷，像是刚有人坐过。可长椅这一侧，积了很厚一层灰。",
      "options": [
        {
          "text": "坐下",
          "resultText": "身侧的凹陷慢慢回弹。有什么东西站起来，走远了。你身上一阵发冷，伤口却在发热。",
          "effects": [
            { "type": "ability", "key": "a_heal" },
            { "type": "hp", "value": -20 }
          ]
        },
        {
          "text": "走开",
          "resultText": "你加快脚步。身后没有声音，但你确定那处凹陷变深了一点。",
          "effects": [{ "type": "exp", "value": 25 }]
        }
      ]
    },
    {
      "id": "e_subway",
      "title": "地铁口",
      "text": "台阶一路往下，望不到底。风是从下面往上吹的，带着铁锈和消毒水的味道。",
      "options": [
        {
          "text": "走下去",
          "resultText": "越往下，灯越少。走到第三层时你停住了——下面有人在叫你的名字。",
          "effects": [
            { "type": "exp", "value": 80 },
            { "type": "flag", "key": "went_down", "value": 1 }
          ]
        },
        {
          "text": "退回来",
          "resultText": "你退回地面，风还在吹。台阶上多了一行湿脚印，是往上走的。",
          "effects": [{ "type": "exp", "value": 20 }]
        }
      ]
    },
    {
