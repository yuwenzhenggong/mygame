{
  "events": [
    {
      "id": "e_old_man",
      "title": "山道老者",
      "text": "山道旁坐着一位衣衫褴褛的老者，面前摆着一只破碗。他抬头看你，目光却不像乞丐。",
      "weight": 12,
      "options": [
        {
          "text": "施舍灵石",
          "resultText": "老者收下灵石，随手在你掌心点了一下，一股热流窜入经脉。",
          "effects": [
            { "type": "stat", "key": "spiritStones", "value": -5 },
            { "type": "stat", "key": "cultivation", "value": 40 }
          ]
        },
        {
          "text": "视而不见",
          "resultText": "你从他身边走过。身后传来一声轻笑。",
          "effects": []
        },
        {
          "text": "问其来历",
          "resultText": "老者摇头不答，只在你眉心一点：「记着，莫要急。」你心头一震。",
          "effects": [
            { "type": "flag", "key": "met_old_man", "value": 1 },
            { "type": "stat", "key": "cultivation", "value": 15 }
          ]
        }
      ]
    },
    {
